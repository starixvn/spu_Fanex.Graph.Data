MERGE (cus:Customers{CustId:$CustId, Username:$Username, Username2:$Username2, RoleId:$RoleId, CurrencyId:$CurrencyId, CurrencyName:$CurrencyName, SubscriberId:$SubscriberId, FpsAccountId:$FpsAccountId, IsDeposit:$IsDeposit, CreatedDate:datetime()})
MERGE (dev:Devices{DeviceId:$DeviceId})
MERGE (cus) -[:USED]-> (dev)
WITH cus,dev
MATCH (cus) -[:USED]-> (dev) <-[:USED]- (cus2:Customers)
MERGE (cus) -[:ASSOCIATED]-> (cus2)