MERGE (cus:Customer{CustId:$CustId})
ON CREATE SET cus.Username=$Username, cus.Username2=$Username2, cus.RoleId=$RoleId, cus.CurrencyId=$CurrencyId, cus.CurrencyName=$CurrencyName, cus.SubscriberId=$SubscriberId, cus.FpsAccountId=$FpsAccountId, cus.IsDeposit=$IsDeposit, cus.CreatedDate=$CreatedDate
ON MATCH SET cus.Username=$Username, cus.Username2=$Username2, cus.RoleId=$RoleId, cus.CurrencyId=$CurrencyId, cus.CurrencyName=$CurrencyName, cus.SubscriberId=$SubscriberId, cus.FpsAccountId=$FpsAccountId
MERGE (dev:Device{DeviceId:$DeviceId})
MERGE (cus) -[:USED]-> (dev)
WITH cus,dev
OPTIONAL MATCH (cus)-[:USED]->(dev)<-[:USED]-(:Customer)-[:BELONG_TO]->(g:Group)
OPTIONAL MATCH (cus)-[:BELONG_TO]->(g1:Group)
WITH cus, COLLECT(DISTINCT g) + COLLECT(DISTINCT g1) AS groups
CALL apoc.do.when(size(groups) = 0,
		"CREATE (g:Group) SET g.GroupId = ID(g) RETURN g.GroupId AS groupId",
        "UNWIND $groups AS g RETURN DISTINCT g.GroupId AS groupId",
        {groups: groups}) YIELD value
MATCH (g:Group {GroupId: value.groupId})
WITH cus, collect(g) AS groups
CALL apoc.refactor.mergeNodes(groups) YIELD node
MERGE (cus)-[:BELONG_TO]->(node)