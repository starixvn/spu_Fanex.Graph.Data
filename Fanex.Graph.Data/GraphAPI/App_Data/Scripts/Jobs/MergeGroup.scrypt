MATCH (d:Device {DeviceId: $DeviceId})
MATCH (c:Customer {CustId: $CustId})
WITH c, d
MATCH (d)<-[:USED]-(c1:Customer)-[:BELONG_TO]->(g1:Group)
WHERE c1.CustId <> c.CustId
WITH g1, c LIMIT 1
MATCH (c)-[:BELONG_TO]->(g:Group)
WITH 
	CASE
    	WHEN g1.CustomerQuantity > g.CustomerQuantity THEN g1
        ELSE g END AS bigGroup,
    CASE
    	WHEN g1.CustomerQuantity > g.CustomerQuantity THEN g
        ELSE g1 END AS smallGroup
WHERE bigGroup <> smallGroup
WITH bigGroup, smallGroup
MATCH (needMergeCus:Customer)-[:BELONG_TO]->(smallGroup)
CREATE (needMergeCus)-[:BELONG_TO]->(bigGroup)
WITH DISTINCT bigGroup, smallGroup
SET bigGroup.CustomerQuantity = bigGroup.CustomerQuantity + smallGroup.CustomerQuantity
DETACH DELETE smallGroup
