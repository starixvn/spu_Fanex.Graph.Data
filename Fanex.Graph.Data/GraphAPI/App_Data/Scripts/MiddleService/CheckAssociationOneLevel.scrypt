CALL algo.unionFind.stream('
MATCH (c:ArbCN88)
WITH c 
SKIP $skip LIMIT $limit
RETURN id(c) as id', 
'MATCH (c1:ArbCN88)-[:USED]->(:Device)<-[:USED]-(c2:ArbCN88) 
WITH * 
SKIP $skip LIMIT $limit
RETURN id(c1) AS source, id(c2) AS target', 
{graph:'cypher', duplicateRelationships:'skip', concurrency:10})
YIELD nodeId,setId
RETURN algo.asNode(nodeId).CustId AS CustId, setId AS GroupId